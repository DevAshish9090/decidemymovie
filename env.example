# Copy this file to ".env" and fill in your real keys.
# The .env file is gitignored and must NEVER be committed.
# If a key is ever exposed (screenshot, shared zip), regenerate it immediately.

# =====================================================================
# TMDB  (required)  — all film data, posters, streaming availability
# =====================================================================
# The v4 "API Read Access Token" (the long JWT-looking string),
# found under Settings > API on themoviedb.org.
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Which country's streaming catalogue to report (IN, US, GB, ...).
WATCH_REGION=IN

# =====================================================================
# Groq  (the LLM — powers The Vibe and Describe)
# =====================================================================
# API key from https://console.groq.com/keys
# Leave blank to run in "no-LLM" fallback mode (plain TMDB search + rule-based
# mood mapping still work, so you can test the pipeline without a key).
GROQ_API_KEY=
# Recommended model. Avoid Llama 3.x on Groq (deprecated).
GROQ_MODEL=openai/gpt-oss-120b

# =====================================================================
# Database
# =====================================================================
# Local dev = SQLite file. NOTE: the "../" keeps the DB OUTSIDE the folder
# Live Server watches, so writes don't trigger a page reload.
# For production, point this at Postgres, e.g.:
#   postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///../decidemymovie.db

# =====================================================================
# CORS  (which frontend origins may call this API)
# =====================================================================
# Add your LIVE domain here when you deploy. Must be the exact origin,
# not "*", because the session cookie is a credentialed request.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# =====================================================================
# Auth
# =====================================================================
# Google Sign-In OAuth client ID (…apps.googleusercontent.com).
# Leave blank to disable the Google button. No client secret needed.
GOOGLE_CLIENT_ID=

# =====================================================================
# Bug reports / contact form  +  email OTP sending
# =====================================================================
# Reports are ALWAYS saved to the database. SMTP only controls whether a copy
# is also emailed (and whether email OTP codes can be sent). Leave SMTP_HOST
# blank to run in DB-only mode; OTP codes then print to the server console.
REPORT_TO=admin@decidemymovie.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
